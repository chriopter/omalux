/** get the point of the brush at pos t [0,1]  */
static void _brush_get_XY(const float p0x,
                          const float p0y,
                          const float p1x,
                          const float p1y,
                          const float p2x,
                          const float p2y,
                          const float p3x,
                          const float p3y,
                          const float t,
                          float *x,
                          float *y)
{
  const float ti = 1.0f - t;
  const float a = ti * ti * ti;
  const float b = 3.0f * t * ti * ti;
  const float c = 3.0f * sqf(t) * ti;
  const float d = t * t * t;
  *x = p0x * a + p1x * b + p2x * c + p3x * d;
  *y = p0y * a + p1y * b + p2y * c + p3y * d;
}


